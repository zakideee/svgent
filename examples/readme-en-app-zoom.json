  "messages": [
    {
      "id": "cover-user",
      "role": "user",
      "content": "Last issue's cover, for reference. Issue 07 needs its own art — same quiet palette, but a sculptural subject instead of a horizon.",
      "images": [
        {
          "dataUrl": "data:image/webp;base64,",
          "mediaType": "image/webp",
          "width": 768,
          "height": 512,
          "alt": "Last issue's cover: quiet bezier curves over a dawn horizon",
          "fit": "cover"
        }
      ]
    },
    {
      "id": "cover-thinking",
      "role": "thinking",
      "content": "Reading the reference palette and picking a subject"
    },
    {
      "id": "cover-choice",
      "role": "choice",
      "content": "Which direction should the cover take?",
      "options": [
        "Folded paper study — sculptural, one light source",
        "Long-exposure city — motion, cool tones",
        "Botanical ink — dense and high contrast"
      ],
      "freeform": "Folded paper, but keep the warm core the reference glows with"
    },
    {
      "id": "cover-permission",
      "role": "permission",
      "content": "Generate the cover art and write it into assets/covers",
      "decision": "allow-always"
    },
    {
      "id": "cover-image",
      "role": "image",
      "content": "Folded paper sculpture on a slate ground, muted mauve and grey planes, a warm amber core lighting the fold from inside",
      "images": [
        {
          "dataUrl": "data:image/webp;base64,",
          "mediaType": "image/webp",
          "width": 768,
          "height": 512,
          "alt": "A folded paper sculpture on slate, muted planes lit by a warm amber core",
          "fit": "cover"
        }
      ],
      "timing": {
        "durationMs": 5200
      }
    },
    {
      "id": "cover-result",
      "role": "assistant",
      "content": "Done. **The fold carries the light, so the title can sit in the dark half.**\n\n- 3:2, no text baked in — the masthead overlays in layout\n- Warm core picked straight out of the reference\n- `assets/covers/issue-07.webp`"
    }
  ]
}
