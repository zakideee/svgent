{
  "name": "@svgent/cli",
  "version": "0.1.0",
  "description": "Create, inspect, edit, and render authored svgent scripts locally",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakideee/svgent.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "svgent": "./dist/bin.js"
  },
  "files": [
    "dist",
    "fonts",
    "runtime",
    "licenses",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/copy-assets.mts",
    "render": "node dist/bin.js render",
    "test": "vitest run --root ../.. packages/cli/tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@boundsvg/core": "0.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "directory": "package",
    "linkDirectory": false
  },
  "devDependencies": {
    "@svgent/assets": "workspace:*",
    "@svgent/render": "workspace:*",
    "@svgent/scene": "workspace:*",
    "@svgent/authoring": "workspace:*"
  }
}
