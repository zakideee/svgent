{
  "name": "@svgent/assets",
  "version": "0.1.0",
  "private": true,
  "description": "Bundled fonts and licensed shared assets for svgent runtimes",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakideee/svgent.git",
    "directory": "packages/assets"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./internal/*": null
  },
  "files": [
    "dist",
    "fonts",
    "runtime",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsx scripts/copy-runtime-assets.mts && tsup src/index.ts src/node.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts src/node.ts --format esm --dts --sourcemap --watch",
    "test": "vitest run --root ../.. packages/assets/tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
